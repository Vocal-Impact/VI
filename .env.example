# Copy to `.env` for local development:  cp .env.example .env
# In production, set these in Vercel → Project → Settings → Environment Variables.

# ─── Database ────────────────────────────────────────────────────
# Local: `npm run db:local` starts Postgres on port 5433 (no Docker needed).
# Production: Neon → Connection details. Use the *pooled* string here…
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/vocal_impact"
# …and the *direct* (non-pooled) string here for migrations. Optional locally.
# DIRECT_URL=""

# ─── Auth (Better Auth) ──────────────────────────────────────────
# Generate with: openssl rand -base64 32   (at least 32 characters)
BETTER_AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"
# The public URL of the app (e.g. https://vocal-impact.vercel.app)
BETTER_AUTH_URL="http://localhost:3000"
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Email + password sign-in for LOCAL DEVELOPMENT AND TESTS ONLY.
# Refused when VERCEL_ENV=production.
ENABLE_PASSWORD_LOGIN="true"

# ─── Data encryption ─────────────────────────────────────────────
# Encrypts WhatsApp numbers, locations (area + coordinates) and dietary preferences
# in the database (AES-256-GCM). Generate with: openssl rand -base64 32
# KEEP A COPY in the committee password manager: if it is lost, that data is gone.
# Never change it on a database that already has data (see docs/adr/0008).
DATA_ENCRYPTION_KEY=""

# ─── Email ───────────────────────────────────────────────────────
# console = print emails in the terminal (development); brevo = send via Brevo's API;
# smtp = send via any SMTP server (e.g. a Gmail App Password).
EMAIL_TRANSPORT="console"
# The "from" address. With Brevo it must be a verified sender
# (Brevo → Senders, domains & dedicated IPs → Senders).
EMAIL_FROM="Vocal Impact <committee-account@iit.ac.lk>"

# Brevo (recommended): Brevo → SMTP & API → API keys → Generate a new API key.
BREVO_API_KEY=""

# Public https address of the white logo shown at the top of emails. Mail apps can't
# load images from your computer, so until the app is deployed, upload
# public/brand/logo-primary-white.png to Brevo (Campaigns → Images / File manager) and
# paste its link here. Once deployed you can leave this empty: the site's copy is used.
EMAIL_LOGO_URL=""

# SMTP alternative (only if EMAIL_TRANSPORT="smtp"):
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""

# ─── Scheduled jobs ──────────────────────────────────────────────
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>` to /api/cron/daily.
CRON_SECRET="replace-with-a-random-string"

# ─── Maps ────────────────────────────────────────────────────────
# nominatim = geocode areas with OpenStreetMap (free); disabled = never call out.
GEOCODER="nominatim"
NOMINATIM_USER_AGENT="VocalImpactApp/1.0 (contact: committee-account@iit.ac.lk)"
# Optional: free OpenRouteService key for road-route carpool matching.
ORS_API_KEY=""

# ─── Feature flags ───────────────────────────────────────────────
# "false" hides a feature that isn't ready yet. Unset or "true" = shown.
# Lifts home (carpool planning) is still experimental: set this to "false" in production.
FEATURE_LIFTS_HOME="true"
# Optional: Google Maps Geocoding API key. When set, landmarks are looked up on Google
# first (then OpenStreetMap). Google requires a billing account with a card, but the
# free monthly allowance easily covers a choir — set a budget alert of $1 to be safe.
GOOGLE_MAPS_API_KEY=""

# ─── App ─────────────────────────────────────────────────────────
ALLOWED_EMAIL_DOMAIN="iit.ac.lk"
