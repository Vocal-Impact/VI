# Copy to `.env` for local development:  cp .env.example .env
# In production, set these in Vercel → Project → Settings → Environment Variables.

# ─── Database ────────────────────────────────────────────────────
# Local: `npm run db:local` starts Postgres on port 5433 (no Docker needed).
# Production: Neon → Connection details. Use the *pooled* string here…
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/vocal_impact"
# …and the *direct* (non-pooled) string here for migrations. Optional locally.
# DIRECT_URL=""

# ─── Auth (Better Auth) ──────────────────────────────────────────
# Generate with: openssl rand -base64 32   (at least 32 characters)
BETTER_AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"
# The public URL of the app (e.g. https://vocal-impact.vercel.app)
BETTER_AUTH_URL="http://localhost:3000"
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Email + password sign-in for LOCAL DEVELOPMENT AND TESTS ONLY.
# Refused when VERCEL_ENV=production.
ENABLE_PASSWORD_LOGIN="true"

# ─── Email ───────────────────────────────────────────────────────
# console = print emails to the terminal; smtp = really send.
EMAIL_TRANSPORT="console"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
# Committee IIT Google account + an App Password (needs 2-Step Verification).
# If IIT blocks App Passwords, use Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587.
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Vocal Impact <committee-account@iit.ac.lk>"

# ─── Scheduled jobs ──────────────────────────────────────────────
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>` to /api/cron/daily.
CRON_SECRET="replace-with-a-random-string"

# ─── Maps ────────────────────────────────────────────────────────
# nominatim = geocode areas with OpenStreetMap (free); disabled = never call out.
GEOCODER="nominatim"
NOMINATIM_USER_AGENT="VocalImpactApp/1.0 (contact: committee-account@iit.ac.lk)"
# Optional: free OpenRouteService key for road-route carpool matching.
ORS_API_KEY=""

# ─── App ─────────────────────────────────────────────────────────
ALLOWED_EMAIL_DOMAIN="iit.ac.lk"
