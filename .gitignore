# ─── Dependencies ───────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js / build output ─────────────────────────────────────
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# ─── Generated code (recreated by `npm install` → `prisma generate`) ──
src/generated/

# ─── Environment & secrets (NEVER commit) ───────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ─── Local database (embedded Postgres via `npm run db:local`) ──
.local-db/
.local-db-test/

# ─── Real member data (personal data — PDPA) ────────────────────
# Google Form exports must never be committed. Fake fixtures only.
*.csv
!tests/fixtures/**/*.csv

# ─── Testing ────────────────────────────────────────────────────
coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# ─── Deployment ─────────────────────────────────────────────────
.vercel

# ─── Logs ───────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ─── Editors & OS ───────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ─── Local AI-assistant notes (regenerated by `next dev`) ───────
AGENTS.md
CLAUDE.md
.claude/
